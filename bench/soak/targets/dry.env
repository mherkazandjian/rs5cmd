# Dry-run target: the MinIO sidecar of the soak's own compose project (no published port).
# These are throw-away values that exist only inside that sidecar; dry-setup.sh creates the user.
# The real targets are not in the repository: ~/.config/rs5cmd-soak/aws.env and rgw.env.
SOAK_KIND=minio
AWS_ACCESS_KEY_ID=soakdryuser
AWS_SECRET_ACCESS_KEY=soak-dry-run-only-0123456789
AWS_REGION=us-east-1
SOAK_BUCKET=rs5cmd-soak-dry
SOAK_ENDPOINT_URL=http://minio:9000
SOAK_DENIED_BUCKET=rs5cmd-soak-dry-outside
SOAK_PUBLIC_URL=s3://rs5cmd-soak-dry-mb-public/hello.txt
SOAK_THROTTLE_ENDPOINT_URL=http://127.0.0.1:9100
